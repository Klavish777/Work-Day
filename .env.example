# =============================================================================
#  ПРИМЕР секретов. Скопируй в .env и заполни.  НИКОГДА не коммить .env
#  В PowerShell:  Copy-Item .env.example .env   затем открой .env и впиши свои
# =============================================================================

# --- MT5 (счёт ДЕМО!) ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=MetaQuotes-Demo
# Путь к terminal64.exe (в кавычках, если есть пробелы). Оставь пустым, если
# терминал уже запущен и агент должен подключаться к активному.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Реальный счёт (заполняй ТОЛЬКО когда осознанно переходишь на реал) ---
# Отдельный счёт, отдельный терминал (portable), сумма, которую готов потерять.
MT5_REAL_LOGIN=
MT5_REAL_PASSWORD=
MT5_REAL_SERVER=
MT5_REAL_TERMINAL_PATH=

# --- Разрешить реальную торговлю (двойной барьер) ---
# Пока здесь не TRUE — агент физически не отправит ордер на реальный счёт.
I_UNDERSTAND_REAL_MONEY_RISK=FALSE

# --- Уведомления (опционально) ---
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- Сентимент (опционально) ---
NEWS_API_KEY=
